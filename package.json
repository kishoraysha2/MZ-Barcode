{
  "name": "mz-barcode-suite-enterprise",
  "productName": "MZ Barcode Suite Enterprise",
  "private": true,
  "version": "1.0.0",
  "main": "dist-electron/main/index.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build:electron": "esbuild src/main/index.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist-electron/main/index.cjs && esbuild src/preload/index.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist-electron/preload/index.cjs",
    "electron:dev": "concurrently \"vite --port=3000 --host=0.0.0.0\" \"electron .\"",
    "electron:build": "vite build && npm run build:electron && electron-builder",
    "electron:pack": "electron-builder --dir",
    "build": "vite build && npm run build:electron",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-electron release server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.101.4",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.8.0",
    "bwip-js": "^4.11.2",
    "dayjs": "^1.11.21",
    "dotenv": "^17.2.3",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdf-to-printer": "^5.8.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hook-form": "^7.82.0",
    "react-router-dom": "^7.18.1",
    "uuid": "^14.0.1",
    "vite": "^6.2.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bwip-js": "^3.2.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^11.0.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  },
  "build": {
    "appId": "com.mzbarcodesuite.enterprise",
    "productName": "MZ Barcode Suite Enterprise",
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.business"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
